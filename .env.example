PORT=5000

HOST=localhost
USER=user
PASSWORD=password
DATABASE=database
DB_PORT=3306

BASE_URL=http://localhost:{PORT}

# Configuración de OAuth
AUDIENCE=http://localhost:3000
ISSUER_BASEURL=https://dev-je4nmgqlgpt4ne2e.us.auth0.com

# Azure Blob Storage (logos/firmas/archivos)
# Ejemplo (sin secretos):
# AZURE_BLOB_STORAGE_CONNECTION="DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=intercamstorage;AccountKey=<REEMPLAZAR>;BlobEndpoint=https://intercamstorage.blob.core.windows.net/;FileEndpoint=https://intercamstorage.file.core.windows.net/;QueueEndpoint=https://intercamstorage.queue.core.windows.net/;TableEndpoint=https://intercamstorage.table.core.windows.net/"
AZURE_BLOB_STORAGE_CONNECTION=
AZURE_BLOB_STORAGE_CONTAINER=socios-assets

# Compatibilidad legacy (opcional, mantener vacío si usás las vars nuevas)
AZURE_STORAGE_CONNECTION=
AZURE_STORAGE_CONTAINER=socios-assets

# Azure Queue Storage (mensajería)
# Ejemplo: usar la misma connection string del blob si compartís storage account
# AZURE_QUEUE_STORAGE_CONNECTION="DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=intercamstorage;AccountKey=<REEMPLAZAR>;BlobEndpoint=https://intercamstorage.blob.core.windows.net/;FileEndpoint=https://intercamstorage.file.core.windows.net/;QueueEndpoint=https://intercamstorage.queue.core.windows.net/;TableEndpoint=https://intercamstorage.table.core.windows.net/"
AZURE_QUEUE_STORAGE_CONNECTION=
AZURE_QUEUE_NAME=incoming-messages

# SOS-Contador integration (usar valores reales en deploy)
SOS_PROXY_PORT=5001
SOS_API_BASE_URL=https://api.sos-contador.com

# Modo de autenticación: bearer | api_key
SOS_AUTH_MODE=bearer

# Bearer estático (opcional)
SOS_BEARER_TOKEN=

# Bearer dinámico (login), completar si no usás token estático
SOS_AUTH_ENDPOINT=/api-comunidad/login
SOS_AUTH_USERNAME=
SOS_AUTH_PASSWORD=
SOS_REPRESENTED_CUIT=

# API Key / Secret (si SOS_AUTH_MODE=api_key)
SOS_API_KEY=
SOS_API_SECRET=
SOS_API_KEY_HEADER=x-api-key
SOS_API_SECRET_HEADER=x-api-secret

# Timeout de llamadas HTTP
SOS_API_TIMEOUT_MS=15000
